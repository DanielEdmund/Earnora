# ── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Leave DATABASE_URL empty to use the embedded Postgres (PGlite, zero setup).
# Set it to run against real PostgreSQL (see docker-compose.yml).
DATABASE_URL=
PGLITE_DIR=./.pglite

# Leave REDIS_URL empty to use the in-process cache. Set for production Redis.
REDIS_URL=

JWT_SECRET=change-me-in-production-use-32-random-bytes
ACCESS_TOKEN_TTL_SEC=7200

# ── Business rules ──────────────────────────────────────────────────────────
# Plans (pricing/quotas) live in src/plans/plans.ts — Beginner ₦3,000,
# Intermediate ₦6,500, Extreme ₦10,500 (one-time, no expiry).

# Controlled withdrawal windows, WAT (Africa/Lagos). Comma-separated allowed.
WITHDRAWAL_WINDOW=17:00-19:00
WITHDRAWAL_TZ=Africa/Lagos
ALLOW_WITHDRAWAL_QUEUE=true         # accept requests outside the window (queued)
MIN_WITHDRAWAL_KOBO=1500000         # ₦15,000 minimum (requires a plan)
MAX_WITHDRAWALS_PER_WINDOW=1
WITHDRAWAL_MAX_ATTEMPTS=3
PAYOUT_OUTSIDE_WINDOW=true          # drain the payout queue outside the window too (dev; false in prod)

# ── Fraud guardrails ────────────────────────────────────────────────────────
MAX_ACCOUNTS_PER_DEVICE=3
MAX_ACCOUNTS_PER_IP24=10            # /24 subnet, rolling 24h (soft flag)
CLAIM_VELOCITY_PER_MIN=10
MIN_DWELL_SECONDS=5                 # claim -> submit minimum seconds
POW_DIFFICULTY_BITS=14              # proof-of-work on task claims
AUTO_MIN_TRUST=60                   # trust below this -> manual review

# ── Payments (PSP) ──────────────────────────────────────────────────────────
PSP_MODE=simulated                  # simulated | paystack | flutterwave
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
WEBHOOK_SECRET=whsec_change_me      # HMAC-SHA512 webhook signing secret

# ── Ops / demo ──────────────────────────────────────────────────────────────
SEED_DEMO=true
ADMIN_EMAIL=admin@earnora.local
ADMIN_PASSWORD=Admin123!
OUTBOX_POLL_MS=1000
PAYOUT_BATCH_MS=2000


# -- Mail (password-reset OTP emails) -------------------------------------
# Leave SMTP_HOST empty to log the code to the API console only (default).
# Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Earnora <no-reply@earnora.local>
